# Medical AI Services API Keys
# IMPORTANT: The demo key 'helloworld' WILL NOT WORK for real prescriptions!

# 1. Google Cloud Vision API (for OCR - text extraction from images)
# To get your key: https://console.cloud.google.com/apis/credentials
# Enable: Cloud Vision API
EXPO_PUBLIC_GOOGLE_CLOUD_API_KEY=YOUR_GOOGLE_CLOUD_API_KEY_HERE

# 2. OpenAI API (for NLP - Intelligent Analysis) - RECOMMENDED for "Real" Results
# Get key: https://platform.openai.com/api-keys
EXPO_PUBLIC_OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# 3. Google Gemini API (Alternative for NLP)
# Get key: https://aistudio.google.com/app/apikey
EXPO_PUBLIC_GEMINI_API_KEY=AIzaSyB7N1DlIQ1BC0ImgN_2dj3kV_xMukCuxLU

# 4. OCR Space API (fallback OCR service) - FREE TIER AVAILABLE
# Get your FREE API key here: https://ocr.space/ocrapi
# 1. Click "Register for free API key" (Enter email)
# 2. Copy the key you receive
EXPO_PUBLIC_OCR_SPACE_API_KEY=K89061775188957

# ⚠️ CRITICAL: Replace 'YOUR_...' with real keys to get real results!
